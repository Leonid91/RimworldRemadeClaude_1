<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-independent simulation: world, climate, local map, pawns, AI, saves, logging.
       No Godot dependency, so everything here is unit-testable in plain .NET. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>Remade</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the simulation is performance-critical: always JIT-optimised, symbols kept for stack traces -->
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Embed the git commit into AssemblyInformationalVersion ("0.1.0+abc1234[-dirty]") for log headers. -->
  <Target Name="StampGitCommit" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(_GitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(_GitExit)' == '0' And '$(_GitDirty)' == ''">$(_GitSha)</SourceRevisionId>
      <SourceRevisionId Condition="'$(_GitExit)' == '0' And '$(_GitDirty)' != ''">$(_GitSha)-dirty</SourceRevisionId>
      <SourceRevisionId Condition="'$(_GitExit)' != '0'">nogit</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
