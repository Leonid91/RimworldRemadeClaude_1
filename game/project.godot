; Engine configuration file.
; All visuals (meshes, textures, sounds, UI) are generated at runtime from code; there are no imported assets.

config_version=5

[application]

config/name="Rimworld Remade"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="RimworldRemade"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=1
environment/ssao/half_size=true
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=48
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.035, 1)

[shader_globals]

daylight={
"type": "float",
"value": 1.0
}
wind_dir={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
wind_strength={
"type": "float",
"value": 0.4
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_cover={
"type": "float",
"value": 0.3
}
wetness={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
season={
"type": "float",
"value": 0.5
}
focus_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
reveal_pos={
"type": "vec4",
"value": Vector4(0, -100, 0, 0)
}
map_size={
"type": "vec2",
"value": Vector2(256, 256)
}
map_data={
"type": "sampler2D",
"value": ""
}
grass_radius={
"type": "float",
"value": 60.0
}
